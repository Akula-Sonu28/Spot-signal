//@version=6
// =============================================================================
// STRATEGY 2: EMA 9/21 CROSSOVER + VWAP BIAS — NIFTY Intraday
// =============================================================================
// BUY CE: 9 EMA crosses above 21 EMA AND close > VWAP
// BUY PE: 9 EMA crosses below 21 EMA AND close < VWAP
// Stop: 1.5x ATR(14) | Target: 2x risk | Max 2 trades/day
// =============================================================================

strategy(
     "NIFTY S2 — EMA Crossover + VWAP",
     overlay = true,
     pyramiding = 0,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 40,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_bars_back = 500,
     currency = currency.INR
)

const string grpInd     = "Indicators"
const string grpRisk    = "Risk"
const string grpSession = "Session"
const string grpOption  = "Options"
const string grpVisual  = "Visuals"

int emaFastLen     = input.int(9, "Fast EMA", minval = 1, group = grpInd)
int emaSlowLen     = input.int(21, "Slow EMA", minval = 1, group = grpInd)
int atrLen         = input.int(14, "ATR length", minval = 1, group = grpInd)

float atrSlMult    = input.float(1.5, "ATR stop multiplier", minval = 0.5, step = 0.1, group = grpRisk)
float rrRatio      = input.float(2.0, "Risk-Reward ratio", minval = 0.5, maxval = 5.0, step = 0.1, group = grpRisk)

string tzInput     = input.string("Asia/Kolkata", "Timezone", group = grpSession)
int skipOpenMins   = input.int(15, "Skip first X minutes after open", minval = 0, maxval = 60, group = grpSession)
int lastEntryH     = input.int(14, "Last entry hour", minval = 9, maxval = 15, group = grpSession)
int lastEntryM     = input.int(30, "Last entry minute", minval = 0, maxval = 59, group = grpSession)
int squareOffH     = input.int(15, "Square-off hour", minval = 9, maxval = 15, group = grpSession)
int squareOffM     = input.int(15, "Square-off minute", minval = 0, maxval = 59, group = grpSession)
int maxTradesDay   = input.int(2, "Max trades per day", minval = 1, maxval = 5, group = grpSession)

string strikePref  = input.string("ATM or 1-step ITM", "Strike preference", group = grpOption)
string expiryInstr = input.string("Current weekly expiry.", "Expiry note", group = grpOption)
string premiumInstr = input.string("Use 40-50% premium SL for live options.", "Premium note", group = grpOption)

bool showLevels    = input.bool(true, "Show SL/Target", group = grpVisual)
bool showDash      = input.bool(true, "Show dashboard", group = grpVisual)
bool showMarkers   = input.bool(true, "Show markers", group = grpVisual)

f_safe(string txt) =>
    str.replace_all(txt, "\"", "'")

f_num(float x) =>
    na(x) ? "null" : str.tostring(x, format.mintick)

f_json(string sig, string dir, string optSide, float ep, float sl, float tp, string reason) =>
    string r = "{\"signal\":\"" + f_safe(sig) + "\","
    r += "\"direction\":\"" + f_safe(dir) + "\","
    r += "\"underlying\":\"" + f_safe(syminfo.tickerid) + "\","
    r += "\"option_side\":\"" + f_safe(optSide) + "\","
    r += "\"strike\":\"" + f_safe(strikePref) + "\","
    r += "\"expiry\":\"" + f_safe(expiryInstr) + "\","
    r += "\"tf\":\"" + f_safe(timeframe.period) + "\","
    r += "\"entry\":" + f_num(ep) + ","
    r += "\"sl\":" + f_num(sl) + ","
    r += "\"target\":" + f_num(tp) + ","
    r += "\"premium_note\":\"" + f_safe(premiumInstr) + "\","
    r += "\"rr\":" + str.tostring(rrRatio, "#.#") + ","
    r += "\"ts\":\"" + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", tzInput) + "\","
    r += "\"reason\":\"" + f_safe(reason) + "\"}"
    r

// --- Indicators ---
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)
float vwapVal = ta.vwap(hlc3)
float atrVal  = ta.atr(atrLen)

bool bullCross = ta.crossover(emaFast, emaSlow)
bool bearCross = ta.crossunder(emaFast, emaSlow)

// --- Time ---
int barMin = hour(time_close, tzInput) * 60 + minute(time_close, tzInput)
int marketOpen = 9 * 60 + 15
int entryStart = marketOpen + skipOpenMins
int entryEnd = lastEntryH * 60 + lastEntryM
int sqOffMin = squareOffH * 60 + squareOffM

bool isEntryWindow = barMin >= entryStart and barMin < entryEnd
bool isSquareOff = barMin >= sqOffMin

// --- Daily state ---
var int tradesToday = 0
bool isDayChange = ta.change(time("D")) != 0

if isDayChange
    tradesToday := 0

var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var int lastEntryBar = na

bool isFlat = strategy.position_size == 0
bool justWentFlat = strategy.position_size == 0 and nz(strategy.position_size[1]) != 0

if justWentFlat
    activeEntry := na
    activeStop := na
    activeTarget := na

// --- Signals ---
bool longSignal = barstate.isconfirmed and isEntryWindow and bullCross and close > vwapVal and tradesToday < maxTradesDay and isFlat
bool shortSignal = barstate.isconfirmed and isEntryWindow and bearCross and close < vwapVal and tradesToday < maxTradesDay and isFlat

float longStop = close - atrVal * atrSlMult
float shortStop = close + atrVal * atrSlMult
float longRisk = close - longStop
float shortRisk = shortStop - close
float longTarget = close + longRisk * rrRatio
float shortTarget = close - shortRisk * rrRatio

// --- Exits ---
if strategy.position_size > 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("CE_EXIT", from_entry = "BUY_CE", stop = activeStop, limit = activeTarget, disable_alert = true)

if strategy.position_size < 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("PE_EXIT", from_entry = "BUY_PE", stop = activeStop, limit = activeTarget, disable_alert = true)

if barstate.isconfirmed and isSquareOff and strategy.position_size != 0
    string side = strategy.position_size > 0 ? "CE" : "PE"
    string dir = strategy.position_size > 0 ? "LONG_EXIT" : "SHORT_EXIT"
    string sqJson = f_json("SQUARE_OFF", dir, side, activeEntry, activeStop, activeTarget, "EOD")
    strategy.close_all(comment = "SQ OFF", alert_message = sqJson, disable_alert = true)
    alert(sqJson, alert.freq_once_per_bar_close)

// --- Entries ---
if longSignal
    activeEntry := close
    activeStop := longStop
    activeTarget := longTarget
    string buyJson = f_json("BUY_CE", "LONG", "CE", activeEntry, activeStop, activeTarget, "EMA_CROSS_ABOVE_VWAP")
    strategy.entry("BUY_CE", strategy.long, comment = "BUY CE", alert_message = buyJson, disable_alert = true)
    alert(buyJson, alert.freq_once_per_bar_close)
    tradesToday += 1
    lastEntryBar := bar_index

if shortSignal
    activeEntry := close
    activeStop := shortStop
    activeTarget := shortTarget
    string buyJson = f_json("BUY_PE", "SHORT", "PE", activeEntry, activeStop, activeTarget, "EMA_CROSS_BELOW_VWAP")
    strategy.entry("BUY_PE", strategy.short, comment = "BUY PE", alert_message = buyJson, disable_alert = true)
    alert(buyJson, alert.freq_once_per_bar_close)
    tradesToday += 1
    lastEntryBar := bar_index

// --- Plots ---
plot(emaFast, "EMA 9", color = color.new(color.teal, 0), linewidth = 1)
plot(emaSlow, "EMA 21", color = color.new(color.orange, 0), linewidth = 1)
plot(vwapVal, "VWAP", color = color.new(color.blue, 0), linewidth = 2)
plot(showLevels and strategy.position_size != 0 ? activeStop : na, "SL", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(showLevels and strategy.position_size != 0 ? activeTarget : na, "Target", color = color.green, style = plot.style_linebr, linewidth = 2)

plotshape(showMarkers and longSignal, title = "CE", text = "CE", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.small)
plotshape(showMarkers and shortSignal, title = "PE", text = "PE", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.small)

// --- Dashboard ---
var table dash = table.new(position.top_right, 2, 6, border_width = 1)

f_row(int row, string lbl, string val, color bg) =>
    table.cell(dash, 0, row, lbl, bgcolor = color.new(color.black, 5), text_color = color.white, text_size = size.small)
    table.cell(dash, 1, row, val, bgcolor = bg, text_color = color.white, text_size = size.small)

if barstate.islast and showDash
    string biasTxt = close > vwapVal ? "Above VWAP (CE)" : "Below VWAP (PE)"
    color biasBg = close > vwapVal ? color.new(color.green, 0) : color.new(color.red, 0)
    string emaTxt = emaFast > emaSlow ? "Bullish" : "Bearish"
    color emaBg = emaFast > emaSlow ? color.new(color.green, 0) : color.new(color.red, 0)
    string posTxt = strategy.position_size > 0 ? "LONG/CE" : strategy.position_size < 0 ? "SHORT/PE" : "Flat"
    string sessTxt = isEntryWindow ? "Live" : isSquareOff ? "Square-off" : "Closed"
    f_row(0, "VWAP Bias", biasTxt, biasBg)
    f_row(1, "EMA Trend", emaTxt, emaBg)
    f_row(2, "Position", posTxt, color.new(color.gray, 30))
    f_row(3, "Session", sessTxt, isEntryWindow ? color.new(color.green, 0) : color.new(color.orange, 0))
    f_row(4, "Trades", str.tostring(tradesToday) + "/" + str.tostring(maxTradesDay), color.new(color.gray, 30))
    f_row(5, "ATR", str.tostring(atrVal, "#.##"), color.new(color.gray, 30))

alertcondition(longSignal, title = "BUY CE", message = "EMA crossover + VWAP — BUY CE")
alertcondition(shortSignal, title = "BUY PE", message = "EMA crossover + VWAP — BUY PE")
