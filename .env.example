# Upstox (market data only — no orders in Phase 1)
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Safety — must stay false
AUTO_TRADE=false
STRIKE_MODE=ATM_OR_ITM1

# Optional paths
STATE_FILE=data/live/monitor_state.json
EVENT_LOG_CSV=data/live/signals.csv

# Optional tuning
POLL_INTERVAL_SEC=20
CANDLE_CLOSE_BUFFER_SEC=15
ENABLE_EARLY_OR_WATCH=true
WARMUP_DAYS=3
MAX_FETCH_RETRIES=3
TIMEZONE=Asia/Kolkata

# v3.8 exits (defaults = sweep winner)
# SL_MODE=OR_RANGE
# CLOSE_ONLY_SL=true
# SL_BUFFER_PTS=10.0
# RR_RATIO=2.0
# MAX_TRADES_PER_DAY=2

# v3.9 J+ on wide OR days (OR width > 100)
ENABLE_J_PLUS=true
# J_MIN_TRAP_EXCESS=15
# J_MIN_RECLAIM_PTS=8
# J_MIN_VWAP_DIST=8
# J_MIN_BODY_RATIO=0.4
# J_ADX_MIN=20
# J_MINS_AFTER_OR=30
# J_MAX_TRADES_DAY=1
# J_MAX_LOSSES_DAY=1
# J_SKIP_BOTH_TRAPPED=true
# J_ONE_TRAP_SIDE_ONLY=false

# Strategy overrides (defaults match locked Pine)
# MIN_OR_RANGE=25
# MAX_OR_RANGE=100
# ADX_MIN=15
# ATR_SL_MULT=1.2
# RR_RATIO=1.8
# USE_VWAP_FILTER=true
